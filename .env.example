# Copy to .env.local and fill in, or run:
#   vercel env pull .env.local --environment=development
#
# WARNING: production, preview and development currently share one Neon database, so the
# development values are the production ones. A local batch run writes rows the shop sees and
# `pnpm db:migrate` migrates production. See "Known limitations" in README.md for the split.
# Never print or commit any of these values.

# Pooled Neon Postgres connection string. Required: src/db/index.ts and drizzle.config.ts both
# throw at import time without it. `pnpm test tests/db` and two of the three Playwright specs
# skip when it is unset, which is how CI stays green with no database.
DATABASE_URL=

# Direct (non-pooled) Neon connection, set by the Neon integration. No app code reads it today;
# keep it for tooling that needs a session-mode connection.
DATABASE_URL_UNPOOLED=

# Vercel Blob token. Clipart, gallery previews, batch CSVs and export ZIPs are written there.
BLOB_READ_WRITE_TOKEN=

# Z.ai key for clipart generation, clipart description and style choice (src/ai/). Without it a
# set can still be built from an uploaded or `clipart_url` image and falls back to the default
# style; only "Generate clipart" hard-fails.
ZAI_API_KEY=
